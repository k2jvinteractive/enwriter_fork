{
  "name": "emWriter",
  "productName": "emWriter",
  "version": "0.6.3",
  "description": "\u2014Writer",
  "main": "src/main.js",
  "author": "Stixhi Stishi <kineticstishi19@gmail.com>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.stixhi.emwriter",
    "productName": "emWriter",
    "files": [
      "src/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "compression": "normal",
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "emWriter Book",
            "CFBundleTypeExtensions": [
              "mwt"
            ],
            "CFBundleTypeRole": "Editor",
            "LSTypeIsPackage": true,
            "LSHandlerRank": "Owner"
          }
        ]
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "fileAssociations": [
      {
        "ext": "mwt",
        "name": "emWriter Book",
        "description": "emWriter book package",
        "role": "Editor",
        "isPackage": true
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  }
}
